{
  "$defs": {
    "CaptureMode": {
      "enum": [
        "never",
        "on_failure",
        "always"
      ],
      "title": "CaptureMode",
      "type": "string"
    }
  },
  "properties": {
    "timeout_s": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout S"
    },
    "capture_screenshot": {
      "$ref": "#/$defs/CaptureMode",
      "default": "on_failure"
    },
    "capture_html": {
      "$ref": "#/$defs/CaptureMode",
      "default": "never"
    },
    "upload_artifacts": {
      "$ref": "#/$defs/CaptureMode",
      "default": "never"
    },
    "respect_robots": {
      "default": true,
      "title": "Respect Robots",
      "type": "boolean"
    },
    "redact_commenters": {
      "default": false,
      "title": "Redact Commenters",
      "type": "boolean"
    },
    "locale": {
      "default": "zh-CN",
      "title": "Locale",
      "type": "string"
    },
    "resume_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume From"
    },
    "since": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Since"
    },
    "known_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Known Ids",
      "type": "array"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "creator_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creator Id"
    },
    "max_posts": {
      "default": 20,
      "maximum": 200,
      "minimum": 1,
      "title": "Max Posts",
      "type": "integer"
    }
  },
  "title": "SocialCreatorParams",
  "type": "object"
}
