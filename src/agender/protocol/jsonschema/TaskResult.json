        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "HintsForPlanner": {
      "properties": {
        "suggested_followups": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Followups",
          "type": "array"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "suggested_tasks": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Suggested Tasks",
          "type": "array"
        }
      },
      "title": "HintsForPlanner",
      "type": "object"
