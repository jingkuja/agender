  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    },
    "attempt": {
      "default": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "lease_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
