{
  "$defs": {
    "Lease": {
      "properties": {
        "lease_id": {
          "title": "Lease Id",
          "type": "string"
        },
        "lease_until": {
          "title": "Lease Until",
          "type": "string"
        },
        "heartbeat_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 20,
          "title": "Heartbeat S"
        }
      },
      "required": [
        "lease_id",
        "lease_until"
      ],
      "title": "Lease",
      "type": "object"
    },
    "TaskEnvelope": {
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "deadline_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline At"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        }
      },
      "required": [
        "task_id",
        "type"
      ],
      "title": "TaskEnvelope",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskEnvelope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lease": {
      "anyOf": [
        {
          "$ref": "#/$defs/Lease"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "TaskClaim",
  "type": "object"
}
