# Copy to .env. Never commit secrets.
# AGENDER_SERVER_BASE_URL=
# AGENDER_WORKER_TOKEN=
# AGENDER_WORKER_ID=worker-01
# AGENDER_CONFIG=config/config.yaml

# Default: reuse an existing Chrome with remote debugging enabled.
AGENDER_BROWSER_MODE=cdp
AGENDER_CDP_ENDPOINT_URL=http://127.0.0.1:9222
# AGENDER_CDP_TIMEOUT_MS=10000
# Set AGENDER_BROWSER_MODE=playwright to launch the project's own browser.
# AGENDER_BROWSER_HEADLESS=auto
